# Normalize text files; Windows checkouts get CRLF where git config asks for it
* text=auto

# Source / config text
*.cpp text diff=cpp
*.h   text diff=cpp
*.cs  text diff=csharp
*.ini text
*.json text
*.uplugin text
*.uproject text
*.md  text

# ---- Unreal binary assets (Git LFS) ----
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text
